name: Python Test

on:
  push:
  workflow_dispatch:

jobs:
  python-test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Check Python version
        run: python --version

      - name: Run Python
        run: |
          python -c "print('Hello from Python')"
          python -c "print(10 + 20)"
