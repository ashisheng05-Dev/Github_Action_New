name: Git Checkout Test

on:
  push:
  workflow_dispatch:

jobs:
  checkout:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: List files
        run: ls -la

      - name: Show current directory
        run: pwd

      - name: Show Git status
        run: git status
